+// Saving a large database takes seconds. Native multi-threaded builds save on a
+// background thread so the protocol keeps answering meanwhile. Emscripten keeps
+// the synchronous save: an extra pthread there needs a free worker in the pool.
+#if defined(MULTI_THREADING) && !defined(__EMSCRIPTEN__)
+    #define ASYNC_DATABASE_SAVE
+    #include <future>
+    #include <system_error>
+#endif
+
