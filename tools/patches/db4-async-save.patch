+#ifdef ASYNC_DATABASE_SAVE
+std::future<void> pendingDatabaseSave;
+#endif
+
+/// Waits for a background database save to finish. Must be called before the
+/// storage is replaced or destroyed (USEDATABASE, YXSETDATABASE, END, EOF).
+void waitDatabaseSave()
+{
+#ifdef ASYNC_DATABASE_SAVE
+    if (pendingDatabaseSave.valid())
+        pendingDatabaseSave.get();
+#endif
+}
+
+/// YXSAVEDATABASE: prints "Saved database file using N ms." when done, as before.
+void startDatabaseSave()
+{
+    Database::DBStorage *storage = Search::Engine.dbStorage();
+    if (!storage)
+        return;
+
+    auto saveNow = [storage] {
+        auto startTime = now();
+        storage->flush();
+        MESSAGEL("Saved database file using " << (now() - startTime) << " ms.");
+    };
+
+    waitDatabaseSave();  // one save at a time; a second request saves again afterwards
+#ifdef ASYNC_DATABASE_SAVE
+    try {
+        pendingDatabaseSave = std::async(std::launch::async, saveNow);
+        return;
+    }
+    catch (const std::system_error &) {
+        // No thread available: fall through to a synchronous save.
+    }
+#endif
+    saveNow();
+}
